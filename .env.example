# ─── Authentication ───
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-nextauth-secret-here
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Database ───
MONGODB_URI=mongodb://localhost:27017/jobquest-ai

# ─── Job APIs ───
FINDWORK_API_KEY=your-findwork-api-key
JOOBLE_API_KEY=your-jooble-api-key
USAJOBS_API_KEY=your-usajobs-api-key
USAJOBS_USER_AGENT=your-usajobs-user-agent
SERP_API_KEY=your-serp-api-key

# ─── Search API ───
SEARCH_API_URLS=["https://search.canine.tools"]

# ─── Naukri Automation ───
NAUKRI_EMAIL=your-naukri-email
NAUKRI_PASSWORD=your-naukri-password

# ─── Telegram ───
TELEGRAM_BOT_TOKEN=your-telegram-bot-token

# ─── Email (SMTP) ───
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-email-app-password
EMAIL_FROM=JobQuest AI <noreply@yourdomain.com>

# ─── Cloudinary ───
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# ─── AI Server ───
AI_SERVER_URL=http://localhost:1234

# ─── Proxy (optional) ───
# HTTP_PROXY=http://proxy:8080
# HTTPS_PROXY=http://proxy:8080

# ─── General ───
NODE_ENV=development
